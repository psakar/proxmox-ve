#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# The pkg.proxmox-ve.lsbservice build profile is for Devuan and other
# systemd-free Debian derivatives (see pve-common's and pve-manager's
# pkg.*.lsbservice profiles): proxmox-ve doesn't depend on systemd-sysv then
# (debian/control), so it can be installed with sysvinit or OpenRC. To build
# this variant, run:
#   dpkg-buildpackage -b -us -uc -Ppkg.proxmox-ve.lsbservice

%:
	dh $@
